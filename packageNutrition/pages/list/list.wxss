/* 营养食材库 · 列表页（自包含样式，主绿 #00C896 与 FitFlow 一致） */
.page {
  padding: 0 24rpx;
  min-height: 100vh;
  background: #F4F6F9;
}

.hero {
  position: relative;
  padding: 36rpx 8rpx 18rpx;
}
.hero-title {
  font-size: 48rpx;
  font-weight: 800;
  color: #1A1F2D;
  letter-spacing: 1rpx;
}
.hero-sub {
  margin-top: 10rpx;
  font-size: 26rpx;
  color: #9AA3B2;
}

/* 搜索框 */
.search-bar {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border-radius: 999rpx;
  padding: 0 24rpx;
  height: 80rpx;
  box-shadow: 0 4rpx 16rpx rgba(22, 28, 45, 0.06);
  border: 2rpx solid transparent;
}
.search-bar:active {
  border-color: #9FE9D4;
}
.search-ico {
  font-size: 30rpx;
  margin-right: 12rpx;
  opacity: 0.6;
}
.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #1A1F2D;
}
.search-ph {
  color: #B6BECB;
}
.search-clear {
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #EDEFF3;
  color: #9AA3B2;
  font-size: 24rpx;
}

/* 计数 */
.count-row {
  display: flex;
  align-items: baseline;
  padding: 26rpx 6rpx 10rpx;
}
.count-num {
  font-size: 40rpx;
  font-weight: 800;
  color: #00A87C;
}
.count-label {
  margin-left: 10rpx;
  font-size: 26rpx;
  color: #9AA3B2;
}

/* 列表 */
.list {
  margin-top: 6rpx;
}
.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 24rpx 26rpx;
  margin-bottom: 18rpx;
  box-shadow: 0 4rpx 16rpx rgba(22, 28, 45, 0.05);
  transition: transform 0.12s ease, box-shadow 0.12s ease;
}
.row:active {
  transform: translateY(2rpx) scale(0.985);
  box-shadow: 0 6rpx 20rpx rgba(22, 28, 45, 0.1);
}
.row-main {
  flex: 1;
  min-width: 0;
  padding-right: 16rpx;
}
.row-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1A1F2D;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.row-sub {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #B6BECB;
}
.row-right {
  flex: none;
  text-align: right;
}
.row-kcal {
  display: flex;
  align-items: baseline;
  justify-content: flex-end;
}
.kcal-num {
  font-size: 34rpx;
  font-weight: 800;
  color: #00A87C;
}
.kcal-unit {
  margin-left: 4rpx;
  font-size: 20rpx;
  color: #9AA3B2;
}
.row-macros {
  margin-top: 8rpx;
  display: flex;
  gap: 12rpx;
}
.macro {
  font-size: 20rpx;
  color: #9AA3B2;
}

/* 空状态 */
.empty {
  padding: 120rpx 0;
  text-align: center;
}
.empty-text {
  font-size: 32rpx;
  color: #1A1F2D;
  font-weight: 600;
}
.empty-sub {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #B6BECB;
}

.load-more {
  text-align: center;
  padding: 28rpx 0 8rpx;
  font-size: 26rpx;
  color: #B6BECB;
}

.safe-bottom {
  height: 40rpx;
}

/* ODbL 署名 */
.attribution {
  text-align: center;
  font-size: 22rpx;
  color: #B6BECB;
  padding: 16rpx 0 28rpx;
  line-height: 1.5;
}
