/* 营养食材详情（自包含样式，主绿 #00C896 与 FitFlow 一致） */
.page {
  padding: 0 24rpx;
  min-height: 100vh;
  background: #F4F6F9;
}

.head {
  padding: 36rpx 8rpx 12rpx;
}
.name {
  font-size: 46rpx;
  font-weight: 800;
  color: #1A1F2D;
  line-height: 1.3;
}
.brand {
  margin-top: 10rpx;
  font-size: 26rpx;
  color: #9AA3B2;
}
.tags {
  margin-top: 16rpx;
  display: flex;
  gap: 14rpx;
}
.tag {
  font-size: 24rpx;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  font-weight: 600;
}
.tag-vegan {
  color: #00A87C;
  background: #E6F8F2;
}
.tag-veg {
  color: #2E9E6B;
  background: #E8F5EE;
}

/* 热量主卡 */
.kcal-card {
  margin-top: 24rpx;
  padding: 40rpx 36rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #00C896, #00A87C);
  box-shadow: 0 10rpx 28rpx rgba(0, 168, 124, 0.28);
  color: #fff;
}
.kcal-label {
  font-size: 26rpx;
  opacity: 0.9;
}
.kcal-big {
  margin-top: 10rpx;
  font-size: 72rpx;
  font-weight: 800;
  line-height: 1;
}
.kcal-big-unit {
  font-size: 30rpx;
  font-weight: 600;
  opacity: 0.9;
}

/* 营养网格 */
.grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
  margin-top: 24rpx;
}
.cell {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 28rpx 26rpx;
  box-shadow: 0 4rpx 16rpx rgba(22, 28, 45, 0.05);
}
.cell-num {
  font-size: 40rpx;
  font-weight: 800;
  color: #1A1F2D;
}
.cell-unit {
  font-size: 24rpx;
  font-weight: 600;
  color: #9AA3B2;
  margin-left: 4rpx;
}
.cell-label {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #9AA3B2;
}

/* 署名 */
.attribution {
  margin-top: 36rpx;
  text-align: center;
  font-size: 22rpx;
  color: #B6BECB;
  line-height: 1.5;
}
.attr-sub {
  margin-top: 6rpx;
  font-size: 20rpx;
  color: #C7CDD8;
}

.safe-bottom {
  height: 60rpx;
}

.empty {
  padding: 160rpx 0;
  text-align: center;
}
.empty-text {
  font-size: 32rpx;
  color: #1A1F2D;
  font-weight: 600;
}
