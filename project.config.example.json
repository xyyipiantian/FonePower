{
  "description": "FonePower 健身训练小程序 · 项目配置模板",
  "miniprogramRoot": "./",
  "cloudfunctionRoot": "cloudfunctions/",
  "projectname": "FonePower",
  "appid": "请填入你的小程序 AppID（个人测试可用游客模式 touristappid）",
  "compileType": "miniprogram",
  "setting": {
    "urlCheck": false,
    "es6": true,
    "enhance": true,
    "postcss": true,
    "minified": true,
    "minifyWXSS": true,
    "minifyWXML": true,
    "coverView": true,
    "lazyloadPlaceholderEnable": false,
    "preloadBackgroundData": false,
    "autoAudits": false,
    "uglifyFileName": false,
    "uploadWithSourceMap": true,
    "useMultiFrameRuntime": true,
    "useApiHook": true,
    "useApiHostProcess": true,
    "showShadowRootInWxmlPanel": true,
    "enableEngineNative": false,
    "useIsolateContext": true,
    "useCompilerPlugins": false,
    "ignoreUploadUnusedFiles": true,
    "checkInvalidKey": true,
    "packNpmManually": false,
    "packNpmRelationList": [],
    "babelSetting": {
      "ignore": [],
      "disablePlugins": [],
      "outputPath": ""
    },
    "compileWorklet": false,
    "localPlugins": false,
    "disableUseStrict": false,
    "condition": false,
    "swc": false,
    "disableSWC": true
  },
  "packOptions": {
    "ignore": [
      { "value": "docs", "type": "folder" },
      { "value": "dataset-ref", "type": "folder" },
      { "value": "design", "type": "folder" },
      { "value": "wger-preview", "type": "folder" },
      { "value": "cloudfunctions", "type": "folder" },
      { "value": "README.md", "type": "file" },
      { "value": "commitlint.config.js", "type": "file" }
    ],
    "include": []
  },
  "condition": {},
  "simulatorPluginLibVersion": {},
  "editorSetting": {}
}