/* =====================================================================
   FitFlow · 训练计划列表 (Plans)  —  设计系统覆盖层
   ===================================================================== */

.page {
  padding: 0 24rpx;
  min-height: 100vh;
}

/* ---------- 顶部标题 ---------- */
.hero-head {
  position: relative;
  padding: 36rpx 8rpx 18rpx;
}
.hero-head::before {
  content: '';
  position: absolute;
  left: 8rpx;
  top: 14rpx;
  width: 64rpx;
  height: 8rpx;
  border-radius: 8rpx;
  background: var(--ff-grad-primary);
}
.hero-title {
  font-size: var(--ff-fs-3xl);
  font-weight: 800;
  color: var(--ff-ink-900);
  letter-spacing: 1rpx;
}
.hero-sub {
  margin-top: 10rpx;
  font-size: var(--ff-fs-base);
  color: var(--ff-ink-500);
}

/* ---------- 计划卡片 ---------- */
.plan-list {
  margin-top: 18rpx;
}
.plan-card {
  overflow: hidden;
  margin-bottom: 24rpx;
}
.plan-cover {
  position: relative;
  height: 200rpx;
  padding: 28rpx;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  color: #fff;
}
.plan-cover.primary { background: linear-gradient(135deg, #00A87C 0%, #00D6A8 100%); }
.plan-cover.blue    { background: linear-gradient(135deg, #2563EB 0%, #38BDF8 100%); }
.plan-cover.violet  { background: linear-gradient(135deg, #7C3AED 0%, #A78BFA 100%); }
.plan-cover.amber   { background: linear-gradient(135deg, #F59E0B 0%, #FBBF24 100%); }
.plan-cover.accent  { background: var(--ff-grad-accent); }
.plan-cover.rose    { background: linear-gradient(135deg, #F43F5E 0%, #FB7185 100%); }
.plan-cover.coral   { background: linear-gradient(135deg, #7C2D12 0%, #C2410C 50%, #EA580C 100%); }
.plan-cover.custom  { background: linear-gradient(135deg, #334155 0%, #64748B 100%); }

/* 创建计划入口 */
.create-btn {
  margin-top: 28rpx;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  border-radius: var(--ff-r-lg);
  border: 2rpx dashed var(--ff-primary-500);
  color: var(--ff-primary-600);
  font-size: var(--ff-fs-lg);
  font-weight: 700;
  background: var(--ff-primary-50);
  transition: transform var(--ff-tr-fast);
}
.create-btn:active { transform: scale(0.98); }
.cb-plus {
  font-size: 40rpx;
  font-weight: 400;
  line-height: 1;
}
.custom-section { margin-top: 20rpx; }

.plan-wm {
  position: absolute;
  right: 24rpx;
  top: 24rpx;
  width: 88rpx;
  height: 88rpx;
  opacity: 0.28;
}
.plan-level {
  position: absolute;
  left: 28rpx;
  top: 24rpx;
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 6rpx 16rpx;
  font-size: var(--ff-fs-xs);
  font-weight: 600;
  background: rgba(255, 255, 255, 0.22);
  -webkit-backdrop-filter: blur(6rpx);
  backdrop-filter: blur(6rpx);
  border-radius: var(--ff-r-full);
}
.pl-fire { width: 22rpx; height: 22rpx; }
.plan-name {
  font-size: var(--ff-fs-2xl);
  font-weight: 800;
  letter-spacing: 1rpx;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.12);
}

.plan-body {
  padding: 24rpx 26rpx 26rpx;
}
.plan-desc {
  font-size: var(--ff-fs-base);
  color: var(--ff-ink-700);
  line-height: 1.65;
}
.plan-meta {
  display: flex;
  align-items: center;
  margin: 18rpx 0 16rpx;
}
.pm {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: var(--ff-fs-sm);
  color: var(--ff-primary-600);
  font-weight: 600;
}
.pm-ico { width: 26rpx; height: 26rpx; }
.pm-count {
  margin-left: auto;
  font-size: var(--ff-fs-sm);
  color: var(--ff-ink-400);
}
.plan-tags {
  display: flex;
  flex-wrap: wrap;
}

.plan-badges {
  margin-top: 14rpx;
  display: flex; flex-wrap: wrap; gap: 8rpx;
}
.plan-badge {
  display: inline-block;
  padding: 4rpx 14rpx;
  background: linear-gradient(135deg, #F0F9FF, #ECFDF5);
  color: #075985;
  border-radius: 999rpx;
  font-size: 22rpx; font-weight: 600;
}
.plan-badge.muted {
  background: #F1F5F9;
  color: #64748B;
  font-weight: 500;
}

.safe-bottom { height: 200rpx; }

/* 一键返回顶部：浅青底悬浮按钮，保证清晰又不抢眼 */
.back-top {
  position: fixed;
  right: 24rpx;
  bottom: 200rpx;
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: var(--ff-primary-50);
  border: 1rpx solid var(--ff-primary-200);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 20rpx rgba(22, 28, 45, 0.12);
  z-index: 50;
  animation: bt-in var(--ff-tr) ease-out;
  transition: transform var(--ff-tr-fast), box-shadow var(--ff-tr-fast), background var(--ff-tr-fast);
}
.back-top:active {
  transform: scale(0.92);
  box-shadow: 0 4rpx 14rpx rgba(22, 28, 45, 0.1);
  background: #ffffff;
}
.back-top .bt-ico {
  width: 36rpx;
  height: 36rpx;
}
@keyframes bt-in {
  from { opacity: 0; transform: scale(0.6) translateY(24rpx); }
  to   { opacity: 1; transform: scale(1) translateY(0); }
}

/* ---------- 编辑模式 ---------- */
.edit-toggle {
  position: absolute;
  right: 8rpx;
  top: 40rpx;
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  font-size: var(--ff-fs-sm);
  font-weight: 600;
  color: var(--ff-primary-600);
  background: var(--ff-primary-50);
  border: 1rpx solid var(--ff-primary-200);
  transition: all var(--ff-tr-fast);
}
.edit-toggle.on {
  color: #fff;
  background: var(--ff-primary-600);
  border-color: var(--ff-primary-600);
}
.edit-toggle:active {
  transform: scale(0.95);
}

.plan-card.editing {
  position: relative;
}
.plan-card.editing:active {
  transform: none;
}

.plan-order {
  position: absolute;
  right: 20rpx;
  top: 50%;
  transform: translateY(-50%);
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  z-index: 5;
}
.po-btn {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: var(--ff-primary-600);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(0, 168, 124, 0.35);
  transition: transform var(--ff-tr-fast);
}
.po-btn:active {
  transform: scale(0.9);
  background: var(--ff-primary-700);
}
.po-btn .ico {
  width: 28rpx;
  height: 28rpx;
}
