<view class="page">
  <!-- 深色 Hero -->
  <view class="hero">
    <view class="hero-row">
      <view class="hero-stat">
        <view class="hs-num">{{total}}</view>
        <view class="hs-label">总训练</view>
      </view>
      <view class="hero-divider"></view>
      <view class="hero-stat">
        <view class="hs-num">{{thisWeek}}</view>
        <view class="hs-label">本周</view>
      </view>
    </view>
  </view>

  <view class="sec-title">历史记录</view>

  <view class="log-list" wx:if="{{logs.length}}">
    <view class="log-item ff-card" wx:for="{{logs}}" wx:key="id">
      <view class="log-head">
        <view class="log-date">
          <view class="log-day">{{item.date}}</view>
          <view class="log-time">{{item.time}}</view>
        </view>
        <view class="log-name">{{item.planName}}</view>
      </view>
      <view class="log-sub">
        <text class="sub-pill">{{item.dayName}}</text>
        <text class="sub-pill primary">{{item.totalSets}} 组</text>
        <text class="sub-pill primary">{{item.itemsCount}} 动作</text>
        <text class="sub-pill warn">{{item.durationMin}} 分钟</text>
      </view>
      <view class="log-actions" wx:if="{{item.canReplay}}">
        <view class="replay-btn" bindtap="replay" data-id="{{item.id}}">🔁 再来一次</view>
        <view class="delete-btn" bindtap="deleteLog" data-id="{{item.id}}">删除</view>
      </view>
    </view>
  </view>

  <view class="empty" wx:else>
    <view class="empty-emoji">🏋️</view>
    <view class="empty-text">还没有训练记录</view>
    <view class="empty-tip">开始第一次训练，记录会自动出现在这里</view>
  </view>

  <view class="safe-bottom"></view>
</view>