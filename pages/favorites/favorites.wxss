/* =====================================================================
   FitFlow · 收藏页 (Favorites)  —  设计系统覆盖层
   卡片视觉语言与首页 index 保持一致，仅消费全局设计令牌。
   ===================================================================== */

.page {
  padding: 0 24rpx;
  min-height: 100vh;
}

/* ---------- 顶部标题 ---------- */
.hero-head {
  position: relative;
  padding: 36rpx 8rpx 18rpx;
}
.hero-head::before {
  content: '';
  position: absolute;
  left: 8rpx;
  top: 14rpx;
  width: 64rpx;
  height: 8rpx;
  border-radius: 8rpx;
  background: var(--ff-grad-accent);
}
.hero-title {
  font-size: var(--ff-fs-3xl);
  font-weight: 800;
  color: var(--ff-ink-900);
  letter-spacing: 1rpx;
}
.hero-sub {
  margin-top: 10rpx;
  font-size: var(--ff-fs-base);
  color: var(--ff-ink-500);
}

/* ---------- 动作网格（与首页同构） ---------- */
.grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 22rpx;
  margin-top: 18rpx;
}
.card {
  background: var(--ff-surface);
  border-radius: var(--ff-r-lg);
  overflow: hidden;
  box-shadow: var(--ff-shadow-sm);
  transition: transform var(--ff-tr-fast), box-shadow var(--ff-tr-fast);
}
.card:active {
  transform: translateY(2rpx) scale(0.985);
  box-shadow: var(--ff-shadow-md);
}
.thumb {
  position: relative;
  width: 100%;
  height: 240rpx;
  background: var(--ff-line);
  overflow: hidden;
}
.thumb::after {
  content: '';
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 80rpx;
  background: linear-gradient(to top, rgba(0, 0, 0, 0.38), transparent);
}
.thumb-img {
  width: 100%;
  height: 100%;
  display: block;
  transition: transform var(--ff-tr);
}
.card:active .thumb-img {
  transform: scale(1.06);
}
.thumb-tag {
  position: absolute;
  left: 12rpx;
  bottom: 12rpx;
  z-index: 2;
  padding: 4rpx 14rpx;
  font-size: var(--ff-fs-xs);
  color: #fff;
  background: rgba(0, 0, 0, 0.42);
  border-radius: var(--ff-r-full);
  -webkit-backdrop-filter: blur(4rpx);
  backdrop-filter: blur(4rpx);
}
.card-name {
  padding: 16rpx 18rpx 4rpx;
  font-size: var(--ff-fs-base);
  font-weight: 600;
  color: var(--ff-ink-900);
  line-height: 1.35;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}
.card-meta {
  padding: 0 18rpx 18rpx;
  font-size: var(--ff-fs-xs);
  color: var(--ff-ink-400);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* ---------- 空状态 ---------- */
.empty {
  padding: 140rpx 0;
  text-align: center;
}
.empty-ico { width: 96rpx; height: 96rpx; }
.empty-text { margin-top: 20rpx; font-size: var(--ff-fs-xl); color: var(--ff-ink-900); font-weight: 600; }
.empty-sub { margin-top: 8rpx; font-size: var(--ff-fs-base); color: var(--ff-ink-400); }

.load-more {
  text-align: center;
  padding: 28rpx 0 8rpx;
  font-size: var(--ff-fs-base);
  color: var(--ff-ink-400);
}

.safe-bottom { height: 200rpx; }
