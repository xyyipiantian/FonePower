<!-- 收藏：本地收藏的动作列表 -->
<view class="page">

  <!-- 顶部标题 -->
  <view class="hero-head">
    <view class="hero-title">我的收藏</view>
    <view class="hero-sub">已收藏 {{total}} 个动作 · 点击查看详情</view>
  </view>

  <!-- 收藏网格 -->
  <view class="grid" wx:if="{{list.length > 0}}">
    <view
      class="card"
      wx:for="{{list}}"
      wx:key="id"
      bindtap="goDetail"
      data-id="{{item.id}}"
    >
      <view class="thumb">
        <image
          wx:if="{{!item._err}}"
          class="thumb-img"
          src="{{item.image}}"
          mode="aspectFill"
          lazy-load
          binderror="onImgError"
          data-id="{{item.id}}"
        />
        <view wx:else class="thumb ph-box">{{item.initial}}</view>
        <view class="thumb-tag">{{item.bodyPartLabel}}</view>
      </view>
      <view class="card-name">{{item.name}}</view>
      <view class="card-meta">{{item.equipmentLabel}} · {{item.targetLabel}}</view>
    </view>
  </view>

  <!-- 空状态 -->
  <view wx:else class="empty">
    <view class="empty-ico ico ico-heart-o-gray"></view>
    <view class="empty-text">还没有收藏的动作</view>
    <view class="empty-sub">在动作详情页点击收藏按钮即可收藏</view>
  </view>

  <view wx:if="{{hasMore}}" class="load-more">上拉加载更多…</view>

  <view class="safe-bottom"></view>

  <!-- 收藏引导（添加到「我的小程序」） -->
  <fav-guide id="favGuide" />
</view>
