.page { padding: 0 24rpx; min-height: 100vh; }

.form-card { padding: 24rpx; margin-top: 20rpx; }
.field { margin-bottom: 20rpx; }
.field:last-child { margin-bottom: 0; }
.field-label { font-size: var(--ff-fs-sm); color: var(--ff-ink-500); margin-bottom: 8rpx; }
.field-input {
  height: 80rpx;
  background: var(--ff-bg);
  border-radius: var(--ff-r-md);
  padding: 0 20rpx;
  font-size: var(--ff-fs-base);
}

.sec-title {
  margin-top: 28rpx;
  font-size: var(--ff-fs-lg);
  font-weight: 700;
  color: var(--ff-ink-900);
  margin-bottom: 16rpx;
}

.search-box { padding: 16rpx; }
.search-input {
  height: 72rpx;
  background: var(--ff-bg);
  border-radius: var(--ff-r-md);
  padding: 0 20rpx;
  font-size: var(--ff-fs-base);
}
.bp-bar {
  margin-top: 14rpx;
  white-space: nowrap;
  height: 60rpx;
}
.bp-chip {
  display: inline-block;
  padding: 8rpx 20rpx;
  margin-right: 12rpx;
  background: #F1F5F9;
  color: #475569;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 600;
}
.bp-chip.on {
  background: linear-gradient(135deg, #0EA5E9, #22C55E);
  color: #fff;
}
.bp-count {
  margin-left: 6rpx;
  font-size: 20rpx;
  opacity: 0.7;
}
.search-results { margin-top: 12rpx; }
.sr-item {
  display: flex;
  align-items: center;
  padding: 12rpx 8rpx;
  border-bottom: 1rpx solid var(--ff-line);
}
.sr-item:last-child { border-bottom: none; }
.sr-thumb { width: 72rpx; height: 72rpx; border-radius: var(--ff-r-sm); background: var(--ff-line); }
.sr-info { flex: 1; margin-left: 16rpx; min-width: 0; }
.sr-name { font-size: var(--ff-fs-base); color: var(--ff-ink-900); font-weight: 600; }
.sr-sub { margin-top: 4rpx; font-size: 20rpx; color: var(--ff-ink-400); }
.sr-add {
  width: 48rpx; height: 48rpx; line-height: 48rpx; text-align: center;
  border-radius: 50%; background: var(--ff-grad-primary); color: #fff;
  font-size: 30rpx; font-weight: 400;
}
.sr-empty { padding: 24rpx 0; text-align: center; color: var(--ff-ink-400); font-size: var(--ff-fs-sm); }

.picked-list { margin-top: 12rpx; }
.picked-item { padding: 18rpx; margin-top: 16rpx; }
.pi-head { display: flex; align-items: center; }
.pi-thumb { width: 72rpx; height: 72rpx; border-radius: var(--ff-r-sm); background: var(--ff-line); }
.pi-name { flex: 1; margin-left: 14rpx; font-size: var(--ff-fs-base); font-weight: 600; color: var(--ff-ink-900); }
.pi-remove {
  width: 48rpx; height: 48rpx; line-height: 44rpx; text-align: center;
  color: var(--ff-ink-400); font-size: 34rpx; border-radius: 50%;
}
.pi-remove:active { background: var(--ff-line); }

.pi-fields { display: flex; margin-top: 16rpx; gap: 12rpx; }
.pi-order {
  display: flex; align-items: center; gap: 12rpx;
  margin-top: 14rpx; padding-top: 14rpx;
  border-top: 1rpx dashed #E2E8F0;
}
.pi-order-btn {
  padding: 6rpx 16rpx;
  background: #F1F5F9; color: #475569;
  border-radius: 999rpx;
  font-size: 22rpx; font-weight: 600;
}
.pi-order-btn:active { background: #E2E8F0; }
.pi-order-no {
  margin-left: auto;
  font-size: 22rpx; color: #94A3B8;
}
.pi-field {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.pi-label { font-size: var(--ff-fs-xs); color: var(--ff-ink-400); margin-bottom: 6rpx; }
.pi-input {
  width: 100%;
  height: 64rpx;
  text-align: center;
  background: var(--ff-bg);
  border-radius: var(--ff-r-sm);
  font-size: var(--ff-fs-base);
}

.pi-note {
  margin-top: 16rpx;
  padding: 12rpx 14rpx;
  background: #F0F9FF;
  border-left: 4rpx solid #0EA5E9;
  border-radius: var(--ff-r-sm);
}
.pi-note.cue {
  background: #FEF3C7;
  border-left-color: #F59E0B;
}
.pi-note-label {
  display: block;
  font-size: var(--ff-fs-xs);
  font-weight: 700;
  color: #075985;
  margin-bottom: 6rpx;
}
.pi-note.cue .pi-note-label { color: #92400E; }
.pi-textarea {
  width: 100%;
  min-height: 56rpx;
  font-size: var(--ff-fs-sm);
  line-height: 1.6;
  color: var(--ff-ink-700);
  box-sizing: border-box;
}

.picked-empty {
  padding: 40rpx 0; text-align: center; color: var(--ff-ink-400); font-size: var(--ff-fs-sm);
}

.save-btn {
  margin-top: 32rpx;
  height: 96rpx;
  display: flex; align-items: center; justify-content: center;
  border-radius: var(--ff-r-lg);
  background: var(--ff-grad-primary);
  color: #fff; font-size: var(--ff-fs-lg); font-weight: 700;
  box-shadow: var(--ff-shadow-md);
}
.save-btn:active { transform: scale(0.98); }

.safe-bottom { height: 40rpx; }
