/* =====================================================================
   FitFlow · 我的页 (Profile)  —  设计系统覆盖层
   ===================================================================== */

.page {
  padding: 0 24rpx;
  min-height: 100vh;
}

/* ---------- 品牌 Hero 卡 ---------- */
.brand {
  margin: 24rpx 0 22rpx;
  padding: 48rpx 32rpx;
  border-radius: var(--ff-r-xl);
  background: var(--ff-grad-hero);
  box-shadow: var(--ff-shadow-md);
  color: #fff;
  text-align: center;
}
.brand-logo {
  width: 120rpx;
  height: 120rpx;
  margin: 0 auto 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.18);
  -webkit-backdrop-filter: blur(6rpx);
  backdrop-filter: blur(6rpx);
}
.bl-ico {
  width: 60rpx;
  height: 60rpx;
}
.brand-name {
  font-size: var(--ff-fs-3xl);
  font-weight: 800;
  letter-spacing: 2rpx;
}
.brand-tag {
  margin-top: 10rpx;
  font-size: var(--ff-fs-base);
  opacity: 0.92;
}

/* ---------- 统计 ---------- */
.stats {
  display: flex;
  align-items: center;
  padding: 32rpx 16rpx;
  background: var(--ff-surface);
  border-radius: var(--ff-r-lg);
  box-shadow: var(--ff-shadow-sm);
}
.stat {
  flex: 1;
  text-align: center;
}
.stat-num {
  font-size: var(--ff-fs-2xl);
  font-weight: 800;
  color: var(--ff-ink-900);
  line-height: 1.1;
}
.stat-label {
  margin-top: 8rpx;
  font-size: var(--ff-fs-xs);
  color: var(--ff-ink-500);
}
.stat-divider {
  width: 2rpx;
  height: 56rpx;
  background: var(--ff-line);
}

/* ---------- 区块卡片 ---------- */
.section {
  background: var(--ff-surface);
  border-radius: var(--ff-r-lg);
  padding: 28rpx 24rpx;
  margin-top: 22rpx;
  box-shadow: var(--ff-shadow-sm);
}
.about-text {
  font-size: var(--ff-fs-base);
  color: var(--ff-ink-700);
  line-height: 1.7;
}
.link {
  color: var(--ff-primary-600);
  font-weight: 600;
}
.attr {
  margin-top: 16rpx;
  font-size: var(--ff-fs-xs);
  color: var(--ff-ink-400);
  line-height: 1.6;
}

.safe-bottom { height: 200rpx; }
