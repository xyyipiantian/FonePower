<!-- 我的：品牌概览 + 统计 + 关于 -->
<view class="page">

  <!-- 品牌 Hero 卡 -->
  <view class="brand">
    <view class="brand-logo"><view class="ico ico-dumbbell bl-ico"></view></view>
    <view class="brand-name">FitFlow</view>
    <view class="brand-tag">健身动作库 · 科学训练指南</view>
  </view>

  <!-- 统计 -->
  <view class="stats">
    <view class="stat">
      <view class="stat-num ff-gradient-text">{{total}}</view>
      <view class="stat-label">动作总数</view>
    </view>
    <view class="stat-divider"></view>
    <view class="stat">
      <view class="stat-num">{{bodyPartCount}}</view>
      <view class="stat-label">身体部位</view>
    </view>
    <view class="stat-divider"></view>
    <view class="stat">
      <view class="stat-num">{{favCount}}</view>
      <view class="stat-label">我的收藏</view>
    </view>
  </view>

  <!-- 关于数据源 -->
  <view class="section">
    <view class="sec-title">关于数据</view>
    <view class="about-text">
      本应用动作数据来源于开源数据集
      <text class="link" bindtap="openRepo">exercises-dataset</text>，涵盖
      {{total}} 个训练动作，支持按身体部位、训练器械与目标肌群多维度检索。
    </view>
    <view class="attr">演示媒体版权归属
      <text class="link" bindtap="openGymvisual">Gym visual</text>，仅作学习展示之用。
    </view>
  </view>

  <view class="safe-bottom"></view>

  <!-- 收藏引导（添加到「我的小程序」） -->
  <fav-guide id="favGuide" />
</view>
