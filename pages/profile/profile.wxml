<!-- 我的：品牌概览 + 统计 + 关于 -->
<view class="page">

  <!-- 品牌 Hero 卡 -->
  <view class="brand">
    <view class="brand-logo"><view class="ico ico-dumbbell bl-ico"></view></view>
    <view class="brand-name">FitFlow</view>
    <view class="brand-tag">健身动作库 · 科学训练指南</view>
  </view>

  <!-- 统计 -->
  <view class="stats">
    <view class="stat">
      <view class="stat-num ff-gradient-text">{{total}}</view>
      <view class="stat-label">动作总数</view>
    </view>
    <view class="stat-divider"></view>
    <view class="stat">
      <view class="stat-num">{{bodyPartCount}}</view>
      <view class="stat-label">身体部位</view>
    </view>
    <view class="stat-divider"></view>
    <view class="stat">
      <view class="stat-num">{{favCount}}</view>
      <view class="stat-label">我的收藏</view>
    </view>
  </view>

  <!-- 训练日志入口 -->
  <view class="section">
    <view class="sec-title">我的训练</view>
    <view class="menu-list">
      <view class="menu-item ff-card ff-press" bindtap="goTrainingLog">
        <view class="mi-ico ico ico-clipboard"></view>
        <view class="mi-body">
          <view class="mi-name">训练日志</view>
          <view class="mi-desc">查看所有训练记录、累计次数</view>
        </view>
        <view class="mi-go ico ico-chevron"></view>
      </view>
      <view class="menu-item ff-card ff-press" bindtap="restartOnboarding">
        <view class="mi-ico ico ico-info"></view>
        <view class="mi-body">
          <view class="mi-name">新手引导</view>
          <view class="mi-desc">再看一次 4 步快速上手</view>
        </view>
        <view class="mi-go ico ico-chevron"></view>
      </view>
    </view>
  </view>

  <view class="safe-bottom"></view>

  <!-- 收藏引导（添加到「我的小程序」） -->
  <fav-guide id="favGuide" />
</view>
