/* =====================================================================
   FitFlow · 详情页 (GIF 演示 / 肌群 / 分步要领)  —  设计系统覆盖层
   ===================================================================== */

.page {
  padding: 0 24rpx;
  min-height: 100vh;
}

/* ---------- 演示区 Hero ---------- */
.hero {
  position: relative;
  margin: 20rpx 0 10rpx;
  width: 100%;
  height: 460rpx;
  background: var(--ff-surface);
  border-radius: var(--ff-r-xl);
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--ff-shadow-md);
  border: 2rpx solid var(--ff-line);
}
.hero::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 8rpx;
  background: var(--ff-grad-primary);
  z-index: 2;
}
.hero-gif {
  width: 100%;
  height: 100%;
}
.hero.ph-box {
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  font-size: 80rpx;
}

/* ---------- 收藏按钮 ---------- */
.fav-btn {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  z-index: 3;
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.92);
  box-shadow: var(--ff-shadow-sm);
  transition: transform var(--ff-tr-fast), background var(--ff-tr-fast);
}
.fav-btn:active {
  transform: scale(0.9);
}
.fav-btn.on {
  background: #ffffff;
  border: 1rpx solid var(--ff-accent-200);
  box-shadow: 0 4rpx 16rpx rgba(242, 100, 30, 0.2);
}
.fav-ico {
  width: 36rpx;
  height: 36rpx;
}

/* ---------- 标题区 ---------- */
.head {
  padding: 24rpx 8rpx 8rpx;
}
.name {
  font-size: var(--ff-fs-2xl);
  font-weight: 800;
  color: var(--ff-ink-900);
  line-height: 1.3;
}
.tags {
  margin-top: 16rpx;
}

/* ---------- 区块卡片 ---------- */
.section {
  background: var(--ff-surface);
  border-radius: var(--ff-r-lg);
  padding: 28rpx 24rpx;
  margin-top: 22rpx;
  box-shadow: var(--ff-shadow-sm);
}
.tag-row {
  display: flex;
  flex-wrap: wrap;
}

/* ---------- 动作要领 · 时间线 ---------- */
.steps {
  display: flex;
  flex-direction: column;
}
.step {
  position: relative;
  display: flex;
  align-items: flex-start;
  padding-bottom: 24rpx;
}
.step::before {
  content: '';
  position: absolute;
  left: 23rpx;
  top: 48rpx;
  bottom: 0;
  width: 2rpx;
  background: var(--ff-line-strong);
}
.step:last-child {
  padding-bottom: 0;
}
.step:last-child::before {
  display: none;
}
.step-no {
  flex: none;
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  text-align: center;
  border-radius: 50%;
  background: var(--ff-grad-primary);
  color: #fff;
  font-size: var(--ff-fs-base);
  font-weight: 700;
  margin-right: 20rpx;
  margin-top: 2rpx;
  box-shadow: var(--ff-shadow-sm);
  z-index: 1;
}
.step-text {
  flex: 1;
  font-size: var(--ff-fs-base);
  color: var(--ff-ink-900);
  line-height: 1.6;
  padding-top: 4rpx;
}
.no-steps {
  font-size: var(--ff-fs-base);
  color: var(--ff-ink-400);
}

/* ---------- 媒体来源 ---------- */
.attr {
  margin: 28rpx 8rpx 0;
  font-size: var(--ff-fs-xs);
  color: var(--ff-ink-400);
  text-align: center;
}

.empty {
  padding: 160rpx 0;
  text-align: center;
}
.empty-text { font-size: var(--ff-fs-xl); color: var(--ff-ink-500); }

.safe-bottom { height: 40rpx; }
