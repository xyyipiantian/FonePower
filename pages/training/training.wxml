<!-- FitFlow · 训练页面 -->
<view class="page {{immersive ? 'immersive' : ''}}" wx:if="{{!done}}">
  <!-- 顶部进度条（沉浸态下简化为更隐蔽） -->
  <view class="top-bar {{immersive ? 'top-bar-im' : ''}}">
    <view class="top-back" bindtap="cancelTraining">✕</view>
    <view class="top-title">{{plan.name}}{{dayName ? ' · ' + dayName : ''}}</view>
    <view class="top-progress">{{itemIndex + 1}}/{{items.length}}</view>
    <view class="top-toggle" bindtap="toggleImmersive">
      <view class="tt-ico ico {{immersive ? 'ico-eye-off' : 'ico-eye'}}"></view>
    </view>
  </view>

  <view class="progress-bar" wx:if="{{!immersive}}">
    <view class="progress-fill" style="width: {{(itemIndex / items.length) * 100}}%"></view>
  </view>

  <!-- 当前动作卡（沉浸态下隐藏缩略图） -->
  <view class="current-card ff-card {{immersive ? 'current-card-im' : ''}}" wx:if="{{currentItem}}">
    <view class="current-no">{{itemIndex + 1}}</view>
    <view class="current-body">
      <view class="current-name">{{currentItem.name}}</view>
      <view class="current-meta">
        <text class="meta-pill">{{setsTotal}} 组</text>
        <text class="meta-pill amber">×{{currentItem.reps}}</text>
        <text class="meta-pill red">RPE {{currentItem.rpe}}</text>
      </view>
      <view class="current-rest" wx:if="{{!immersive}}">组间休息 {{currentItem.rest}} 秒</view>
    </view>
    <image
      wx:if="{{currentItem.image && !immersive}}"
      class="current-thumb"
      src="{{currentItem.image}}"
      mode="aspectFill"
      lazy-load
      bindtap="goDetail"
    />
    <view wx:elif="{{!immersive}}" class="current-thumb ph-box" bindtap="goDetail">?</view>
  </view>

  <!-- 沉浸态紧凑进度：保留"第几组 + 做完标记"，但不破坏大字体验 -->
  <view wx:if="{{immersive}}" class="im-progress">
    <text class="im-prog-text">第 {{setIndex + 1}}/{{setsTotal}} 组</text>
    <view class="im-prog-dots">
      <view
        wx:for="{{setProgress}}"
        wx:key="index"
        class="im-prog-dot {{item.done ? 'dot-done' : (index === setIndex ? 'dot-active' : 'dot-pending')}}"
      ></view>
    </view>
    <text class="im-prog-hint" wx:if="{{setIndex + 1 < setsTotal}}">完成本组后休息</text>
  </view>

  <!-- 要点 / 口令（非沉浸态显示） -->
  <view class="note-card ff-card" wx:if="{{currentItem.note && !immersive}}">
    <text class="note-label">要点</text>
    <text class="note-text">{{currentItem.note}}</text>
  </view>
  <view class="cue-card ff-card" wx:if="{{currentItem.cue && !immersive}}">
    <text class="cue-label">口令</text>
    <text class="cue-text">{{currentItem.cue}}</text>
  </view>

  <!-- 组进度（非沉浸态显示） -->
  <view class="sets-card ff-card" wx:if="{{!immersive}}">
    <view class="sets-title">本动作进度（{{setIndex}}/{{setsTotal}}）</view>
    <view class="sets-list">
      <view
        class="set-row {{item.done ? 'done' : (index === setIndex ? 'active' : '')}}"
        wx:for="{{setProgress}}"
        wx:key="index"
      >
        <view class="set-no">第 {{index + 1}} 组</view>
        <view class="set-status">
          <text wx:if="{{item.done}}" class="done-badge">✓ 完成</text>
          <text wx:elif="{{index === setIndex}}" class="active-badge">当前组</text>
          <text wx:else class="pending-badge">未开始</text>
        </view>
        <input
          class="set-weight"
          placeholder="kg"
          value="{{item.weight}}"
          type="digit"
          data-idx="{{index}}"
          bindinput="onWeightInput"
        />
      </view>
    </view>
  </view>

  <!-- 操作按钮（沉浸态下大字大按钮） -->
  <view class="action-area {{immersive ? 'action-area-im' : ''}}">
    <view class="complete-btn {{immersive ? 'complete-btn-im' : ''}}" bindtap="completeSet">
      <view class="cb-ico ico ico-check" wx:if="{{!immersive}}"></view>
      <text wx:if="{{itemIndex + 1 < items.length || setIndex + 1 < setsTotal}}">
        {{immersive ? '完成第 ' + (setIndex + 1) + ' 组' : '完成第 ' + (setIndex + 1) + ' 组'}}
      </text>
      <text wx:else>完成训练 🎉</text>
    </view>
    <view wx:if="{{immersive}}" class="im-hint">沉浸模式 · 已自动锁屏常亮</view>
  </view>

  <!-- 休息倒计时弹层（沉浸态下加大加红） -->
  <view class="rest-mask {{restPulse ? 'rest-mask-pulse' : ''}}" wx:if="{{showRest}}">
    <view class="rest-card {{immersive ? 'rest-card-im' : ''}}">
      <view class="rest-title">休息中</view>
      <view class="rest-time {{restPulse ? 'rest-time-pulse' : ''}}">{{restSeconds}}</view>
      <view class="rest-progress" wx:if="{{!immersive}}">
        <view class="rest-progress-fill" style="width: {{(restSeconds / restTotal) * 100}}%"></view>
      </view>
      <view class="rest-skip" bindtap="skipRest">跳过休息 →</view>
    </view>
  </view>

  <view class="safe-bottom"></view>
</view>

<!-- 完成总结 -->
<view class="done-page" wx:else>
  <view class="done-hero">
    <view class="done-emoji">🎉</view>
    <view class="done-title">训练完成！</view>
    <view class="done-plan">{{summary.planName}} · {{summary.dayName}}</view>
  </view>

  <view class="done-stats ff-card">
    <view class="stat-row">
      <view class="stat-label">总组数</view>
      <view class="stat-value">{{summary.totalSets}}</view>
    </view>
    <view class="stat-row">
      <view class="stat-label">动作数</view>
      <view class="stat-value">{{summary.itemsCount}}</view>
    </view>
    <view class="stat-row">
      <view class="stat-label">训练时长</view>
      <view class="stat-value">{{summary.duration}} 秒</view>
    </view>
  </view>

  <view class="done-tip">已经记录到训练日志，下次练你能看到历史。</view>

  <view class="done-btn" bindtap="finishAndExit">完成</view>
  <view class="safe-bottom"></view>
</view>