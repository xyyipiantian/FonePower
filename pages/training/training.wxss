/* FitFlow · 训练页面 */
.page { padding: 0 24rpx; min-height: 100vh; background: #F8FAFC; padding-top: 24rpx; }

.top-bar {
  display: flex; align-items: center;
  margin-bottom: 16rpx;
}
.top-back {
  width: 56rpx; height: 56rpx; line-height: 52rpx;
  text-align: center; font-size: 36rpx; color: #fff;
  background: rgba(15, 23, 42, 0.06);
  border-radius: 50%;
}
.top-back:active { background: rgba(15, 23, 42, 0.12); }
.top-title {
  flex: 1; margin: 0 16rpx;
  font-size: 30rpx; font-weight: 700; color: #0F172A;
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.top-progress {
  font-size: 24rpx; color: #64748B;
  padding: 4rpx 16rpx; background: #fff; border-radius: 999rpx;
  font-weight: 600;
}

.progress-bar {
  height: 8rpx; background: #E2E8F0; border-radius: 999rpx;
  overflow: hidden; margin-bottom: 24rpx;
}
.progress-fill {
  height: 100%; background: linear-gradient(90deg, #0EA5E9, #22C55E);
  transition: width 0.3s ease;
}

.current-card {
  display: flex; align-items: center;
  padding: 24rpx; margin-top: 8rpx;
}
.current-no {
  flex: none; width: 60rpx; height: 60rpx; line-height: 60rpx;
  text-align: center; border-radius: 50%;
  background: linear-gradient(135deg, #0EA5E9, #22C55E); color: #fff;
  font-weight: 800; font-size: 28rpx;
}
.current-body {
  flex: 1; min-width: 0; padding: 0 16rpx;
}
.current-name {
  font-size: 32rpx; font-weight: 700; color: #0F172A;
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.current-meta { margin-top: 8rpx; display: flex; gap: 10rpx; flex-wrap: wrap; }
.meta-pill {
  display: inline-block; padding: 4rpx 14rpx;
  background: #F1F5F9; color: #0F172A;
  border-radius: 999rpx; font-size: 22rpx; font-weight: 600;
}
.meta-pill.amber { background: #FEF3C7; color: #92400E; }
.meta-pill.red { background: #FEE2E2; color: #991B1B; }
.current-rest {
  margin-top: 8rpx; font-size: 22rpx; color: #64748B;
}
.current-thumb {
  flex: none; width: 120rpx; height: 120rpx; border-radius: 16rpx;
  background: #E2E8F0;
}
.current-thumb.ph-box {
  display: flex; align-items: center; justify-content: center;
  color: #fff; font-size: 48rpx; font-weight: 700;
}

.note-card, .cue-card {
  margin-top: 16rpx; padding: 16rpx 20rpx;
}
.note-card { background: #F0F9FF; border-left: 8rpx solid #0EA5E9; }
.cue-card { background: #FEF3C7; border-left: 8rpx solid #F59E0B; }
.note-label, .cue-label {
  display: block; font-weight: 800; font-size: 24rpx;
  margin-bottom: 6rpx;
}
.note-label { color: #075985; }
.cue-label { color: #92400E; }
.note-text, .cue-text {
  font-size: 26rpx; line-height: 1.7; color: #0F172A;
}

.sets-card { margin-top: 16rpx; padding: 20rpx 24rpx; }
.sets-title {
  font-size: 26rpx; font-weight: 700; color: #0F172A; margin-bottom: 16rpx;
}
.sets-list { display: flex; flex-direction: column; gap: 12rpx; }
.set-row {
  display: flex; align-items: center;
  padding: 16rpx 18rpx;
  background: #F8FAFC; border-radius: 12rpx;
  border-left: 6rpx solid #CBD5E1;
}
.set-row.active {
  background: #FEF3C7; border-left-color: #F59E0B;
}
.set-row.done {
  background: #F0FDF4; border-left-color: #22C55E;
  text-decoration: line-through;
  color: #94A3B8;
}
.set-no {
  flex: 1; font-size: 26rpx; font-weight: 600;
}
.set-status { margin-right: 16rpx; }
.done-badge { color: #16A34A; font-weight: 700; font-size: 22rpx; }
.active-badge { color: #B45309; font-weight: 700; font-size: 22rpx; }
.pending-badge { color: #94A3B8; font-size: 22rpx; }
.set-weight {
  width: 100rpx; height: 56rpx;
  text-align: center; background: #fff;
  border: 2rpx solid #E2E8F0; border-radius: 12rpx;
  font-size: 26rpx;
}

.action-area { margin-top: 24rpx; }
.complete-btn {
  height: 110rpx;
  display: flex; align-items: center; justify-content: center; gap: 12rpx;
  background: linear-gradient(135deg, #22C55E, #16A34A);
  color: #fff; font-size: 30rpx; font-weight: 800;
  border-radius: 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(34, 197, 94, 0.3);
}
.complete-btn:active { transform: scale(0.98); }
.cb-ico { width: 32rpx; height: 32rpx; }

/* 休息遮罩 */
.rest-mask {
  position: fixed; inset: 0;
  background: rgba(15, 23, 42, 0.7);
  display: flex; align-items: center; justify-content: center;
  z-index: 999;
}
.rest-card {
  width: 80%; max-width: 640rpx;
  background: #fff; border-radius: 32rpx;
  padding: 48rpx 32rpx; text-align: center;
}
.rest-title {
  font-size: 28rpx; color: #64748B; margin-bottom: 16rpx;
  font-weight: 600;
}
.rest-time {
  font-size: 120rpx; font-weight: 900; color: #0EA5E9;
  line-height: 1.1; letter-spacing: -4rpx;
  font-feature-settings: 'tnum';
}
.rest-progress {
  margin-top: 24rpx; height: 12rpx; background: #E2E8F0;
  border-radius: 999rpx; overflow: hidden;
}
.rest-progress-fill {
  height: 100%; background: linear-gradient(90deg, #0EA5E9, #22C55E);
  transition: width 1s linear;
}
.rest-skip {
  margin-top: 32rpx; font-size: 28rpx; color: #0EA5E9;
  font-weight: 600;
}

/* 完成页 */
.done-page {
  padding: 80rpx 24rpx 24rpx;
  min-height: 100vh;
  display: flex; flex-direction: column;
}
.done-hero {
  text-align: center; margin-bottom: 48rpx;
}
.done-emoji { font-size: 120rpx; }
.done-title {
  margin-top: 16rpx;
  font-size: 48rpx; font-weight: 900; color: #0F172A;
}
.done-plan {
  margin-top: 8rpx;
  font-size: 28rpx; color: #64748B;
}
.done-stats {
  padding: 24rpx; margin-top: 24rpx;
}
.stat-row {
  display: flex; justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 2rpx solid #F1F5F9;
}
.stat-row:last-child { border-bottom: none; }
.stat-label { font-size: 28rpx; color: #64748B; }
.stat-value { font-size: 32rpx; font-weight: 700; color: #0F172A; }
.done-tip {
  margin-top: 24rpx; text-align: center;
  font-size: 24rpx; color: #94A3B8;
}
.done-btn {
  margin-top: 48rpx; height: 100rpx;
  display: flex; align-items: center; justify-content: center;
  background: linear-gradient(135deg, #0EA5E9, #22C55E);
  color: #fff; font-size: 32rpx; font-weight: 800;
  border-radius: 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(14, 165, 233, 0.3);
}
.done-btn:active { transform: scale(0.98); }

.safe-bottom { height: 40rpx; }